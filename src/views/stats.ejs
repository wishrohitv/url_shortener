<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stats - URL Shortener</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <%- include('partials/header'); -%>

  <main class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <section class="rounded-3xl border border-slate-800 bg-slate-900/70 p-6 shadow-2xl shadow-slate-950/40 backdrop-blur sm:p-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-cyan-400">Link analytics</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Understand every click.</h1>
        <p class="mt-3 text-slate-400">Enter a shortened URL to explore traffic, devices, and countries in one view.</p>
      </div>
      <form method="POST" class="mt-8 grid gap-3 sm:grid-cols-[1fr_auto]">
      <input
        type="url"
        name="url"
        id="url"
        placeholder="https://example.com/tde43"
        required
        class="w-full rounded-2xl border border-slate-700 bg-slate-950/90 px-4 py-4 text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20"
      />
      <button
        type="submit"
        class="rounded-2xl bg-cyan-500 px-6 py-4 text-sm font-semibold uppercase tracking-wide text-slate-950 transition hover:bg-cyan-400 focus:outline-none focus:ring-4 focus:ring-cyan-500/30"
      >
        View analytics
      </button>
    </form>
      <p id="stats-message" class="mt-4 hidden rounded-xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-200"></p>
    </section>

    <section class="mt-8 grid gap-5 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-800 bg-slate-900/70 p-5 shadow-xl shadow-slate-950/20 lg:col-span-2">
        <div class="mb-2"><h2 class="text-lg font-semibold text-white">Clicks over time</h2><p class="text-sm text-slate-500">Daily activity for this shortened link</p></div>
        <div id="line-chart" class="min-h-72"></div>
      </article>
      <article class="rounded-3xl border border-slate-800 bg-slate-900/70 p-5 shadow-xl shadow-slate-950/20">
        <div class="mb-2"><h2 class="text-lg font-semibold text-white">Devices</h2><p class="text-sm text-slate-500">What visitors are using</p></div>
        <div id="donut-chart" class="min-h-72"></div>
      </article>
      <article class="rounded-3xl border border-slate-800 bg-slate-900/70 p-5 shadow-xl shadow-slate-950/20">
        <div class="mb-2"><h2 class="text-lg font-semibold text-white">Top countries</h2><p class="text-sm text-slate-500">Where visitors are coming from</p></div>
        <div id="bar-chart" class="min-h-72"></div>
      </article>
    </section>
  </main>
    <script src="/js/stats.js"></script>
  </body>
</html>
